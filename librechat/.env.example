# Copy to .env for local LibreChat experiments. Cluster secrets use gitops/base/secrets/.
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://127.0.0.1:27017/LibreChat
CREDS_KEY=replace-with-32-byte-hex
JWT_SECRET=replace-with-32-byte-hex
ALLOW_REGISTRATION=true
CONFIG_PATH=./librechat.yaml
LLAMASTACK_API_KEY=not-used
MAAS_API_KEY=sk-oai-CHANGE_ME
