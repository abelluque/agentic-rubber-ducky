# Extra secrets when using platform/ operators (CNPG + MongoDB Community).
# Apply in addition to demo-maas / demo-github / demo-argocd / demo-librechat.
apiVersion: v1
kind: Secret
metadata:
  name: librechat-mongo-user
  namespace: demo-granite
type: Opaque
stringData:
  password: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-librechat
  namespace: demo-granite
type: Opaque
stringData:
  mongo-uri: mongodb://librechat:CHANGE_ME@librechat-mongo-svc.demo-granite.svc.cluster.local:27017/LibreChat?replicaSet=librechat-mongo&authSource=admin
  CREDS_KEY: CHANGE_ME_32BYTE_HEX
  JWT_SECRET: CHANGE_ME_32BYTE_HEX
