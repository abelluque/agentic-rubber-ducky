# Apply AFTER creating namespace demo-granite on the SPOKE cluster.
# demo-maas.api-key is issued on the HUB (./scripts/create-maas-key.sh with hub kubeconfig).
#   oc create namespace demo-granite
#   oc apply -f /tmp/demo-secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: demo-maas
  namespace: demo-granite
type: Opaque
stringData:
  api-key: sk-oai-CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-github
  namespace: demo-granite
type: Opaque
stringData:
  token: ghp_CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-argocd
  namespace: demo-granite
type: Opaque
stringData:
  server: https://openshift-gitops-server-openshift-gitops.apps.CHANGE_ME.example.com
  token: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-target-kubeconfig
  namespace: demo-granite
type: Opaque
stringData:
  kubeconfig: |
    apiVersion: v1
    kind: Config
    clusters: []
    contexts: []
    users: []
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-postgres
  namespace: demo-granite
type: Opaque
stringData:
  password: CHANGE_ME
---
apiVersion: v1
kind: Secret
metadata:
  name: demo-librechat
  namespace: demo-granite
type: Opaque
stringData:
  mongo-uri: mongodb://librechat-mongo:27017/LibreChat
  CREDS_KEY: CHANGE_ME_32BYTE_HEX
  JWT_SECRET: CHANGE_ME_32BYTE_HEX
