# Fallback: install llama-stack-k8s-operator from OperatorHub when RHOAI does not
# manage the component. Do NOT apply this together with the DSC patch on a RHOAI 3.4 cluster.
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: llama-stack-k8s-operator
  namespace: openshift-operators
spec:
  channel: alpha
  installPlanApproval: Automatic
  name: llama-stack-k8s-operator
  source: community-operators
  sourceNamespace: openshift-marketplace
